#!/bin/bash
cd "$(dirname "$0")"
echo "=================================================="
echo "    Запуск локального сервера ExamHub..."
echo "=================================================="
echo "Сайт откроется автоматически на http://localhost:8000"
echo "Для остановки сервера закройте это окно терминала."
echo "=================================================="
open "http://localhost:8000"
node server/index.js
