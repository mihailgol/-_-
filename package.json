{
  "name": "examhub",
  "version": "1.0.0",
  "private": true,
  "description": "ExamHub — интерактивная платформа подготовки к ЕГЭ и ОГЭ (статический SPA)",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "node scripts/validate-project.mjs",
    "check": "npm run lint && npm run build && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
