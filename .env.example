# ExamHub server configuration (copy to .env and adjust)

# HTTP port and bind host
PORT=8000
HOST=0.0.0.0

# SQLite database file (relative to project root)
DB_PATH=data/examhub.db

# Session lifetime in days
SESSION_TTL_DAYS=30

# NODE_ENV=production enables secure cookies (HTTPS required)
# NODE_ENV=test uses a separate database for E2E tests
NODE_ENV=development

# Social OAuth (VK & Yandex ID)
# To enable real social authentication in production, create applications at:
# VK: https://dev.vk.com (Web/Standalone app -> ID & Secure Key)
# Yandex: https://oauth.yandex.ru (Create app with login:email, login:info, login:avatar scopes)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
