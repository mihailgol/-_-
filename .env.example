# ExamHub server configuration (copy to .env and adjust)

# HTTP port and bind host
PORT=8000
HOST=0.0.0.0

# SQLite database file (relative to project root)
DB_PATH=data/examhub.db

# Session lifetime in days
SESSION_TTL_DAYS=30

# NODE_ENV=production enables secure cookies (HTTPS required)
# NODE_ENV=test uses a separate database for E2E tests
NODE_ENV=development
